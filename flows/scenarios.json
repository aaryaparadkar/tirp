{
  "tests": [
    {
      "name": "complete multi-screen session 1 quiz",
      "steps": [
        {
          "expect": {
            "screen": "LESSON",
            "status": "ready"
          }
        },
        {
          "submit": true,
          "expect": {
            "screen": "QUESTION_ONE"
          }
        },
        {
          "fill": "q_one",
          "value": "option_b"
        },
        {
          "submit": true,
          "expect": {
            "screen": "QUESTION_TWO"
          }
        },
        {
          "fill": "q_two",
          "value": "option_b"
        },
        {
          "submit": true,
          "expect": {
            "screen": "QUESTION_THREE"
          }
        },
        {
          "fill": "q_three",
          "value": "option_a"
        },
        {
          "submit": true,
          "expect": {
            "screen": "QUESTION_FOUR"
          }
        },
        {
          "fill": "q_four",
          "value": "option_a"
        },
        {
          "submit": true,
          "expect": {
            "screen": "QUESTION_FIVE"
          }
        },
        {
          "fill": "q_five",
          "value": "option_a"
        },
        {
          "submit": true,
          "expect": {
            "screen": "RESULTS"
          }
        },
        {
          "submit": true,
          "expect": {
            "status": "completed",
            "completion": {
              "q_one": "option_b",
              "q_two": "option_b",
              "q_three": "option_a",
              "q_four": "option_a",
              "q_five": "option_a"
            }
          }
        }
      ]
    }
  ]
}
