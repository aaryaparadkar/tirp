{
  "name": "oshc-whatsapp-catalogue",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "flow:export": "tsx scripts/export-flow.ts",
    "flow:validate": "flowso validate flows/oshc_quiz_flow.json",
    "flow:test": "flowso test flows/oshc_quiz_flow.json --scenario flows/scenarios.json",
    "flow:preview": "flowso preview flows/oshc_quiz_flow.json",
    "flow:serve": "flowso serve flows/oshc_quiz_flow.json"
  },
  "dependencies": {
    "@kapso/whatsapp-cloud-api": "latest",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "flowso": "^0.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "4.1.10"
  }
}
