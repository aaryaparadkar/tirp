PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/oshc_catalogue
DATABASE_SSL=true
KAPSO_API_KEY=replace-with-kapso-api-key
KAPSO_WEBHOOK_SECRET=replace-with-webhook-secret
KAPSO_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
KAPSO_BUSINESS_ACCOUNT_ID=replace-with-whatsapp-business-account-id
OSHC_FLOW_ID=replace-with-published-oshc-flow-id
# Mistral (rotating keys, comma-separated). At least one required for AI answers.
MISTRAL_API_KEYS=key-one,key-two,key-three
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_MS=15000
MISTRAL_MAX_RETRIES=2
MISTRAL_MAX_TOKENS_CLASSIFY=400
MISTRAL_MAX_TOKENS_ANSWER=800
QUIZ_REMINDER_TEMPLATE=replace-with-approved-whatsapp-template-name
QUIZ_REMINDER_TEMPLATE_LANGUAGE=en
# Sandbox/testing only: set to true to skip Kapso HMAC check on localhost tunnel.
KAPSO_SKIP_SIGNATURE=false
