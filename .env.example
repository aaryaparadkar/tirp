PORT=8787
DATABASE_URL=postgresql://user:password@localhost:5432/oshc_catalogue
DATABASE_SSL=true
KAPSO_API_KEY=replace-with-kapso-api-key
KAPSO_WEBHOOK_SECRET=replace-with-webhook-secret
KAPSO_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
KAPSO_BUSINESS_ACCOUNT_ID=replace-with-whatsapp-business-account-id
OSHC_FLOW_ID=replace-with-published-oshc-flow-id
# Mistral (rotating keys, comma-separated). At least one required for AI answers.
MISTRAL_API_KEYS=key-one,key-two,key-three
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_MS=15000
MISTRAL_MAX_RETRIES=2
MISTRAL_MAX_TOKENS_CLASSIFY=400
MISTRAL_MAX_TOKENS_ANSWER=800
QUIZ_REMINDER_TEMPLATE=replace-with-approved-whatsapp-template-name
QUIZ_REMINDER_TEMPLATE_LANGUAGE=en
QUIZ_FLOW_ID=replace-with-published-quiz-flow-id
# Bearer token for the operator-only POST /quiz/start trigger endpoint.
QUIZ_TRIGGER_TOKEN=replace-with-secure-random-token
# Sandbox/testing only: set to true to skip Kapso HMAC check on localhost tunnel.
KAPSO_SKIP_SIGNATURE=false

# --- Dashboard (Phase 3 operator console) ---------------------------------
# Bootstrap the first operator from the environment on start. The password is
# hashed with scrypt before it is stored; it is never kept in plaintext.
DASHBOARD_OPERATOR_EMAIL=operator@example.com
DASHBOARD_OPERATOR_PASSWORD=replace-with-a-strong-password
DASHBOARD_OPERATOR_NAME=Dashboard Operator
DASHBOARD_OPERATOR_ROLE=admin
# Comma-separated browser origins allowed to call the dashboard with cookies.
# Local dashboard default: http://localhost:3000
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000
# Local HTTP uses false; set true behind HTTPS/a Cloudflare Tunnel.
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_SESSION_TTL_MS=43200000
# Optional webhook notified when a conversation is escalated.
DASHBOARD_DESK_WEBHOOK_URL=
